{"coordinate": "uk/ukpga/1996/18", "record_type": "instrument", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18", "title": "Employment Rights Act 1996"}
{"coordinate": "uk/ukpga/1996/18/s124", "crossheading": "Compensation", "number_label": "124", "order": 3998, "parent": "uk/ukpga/1996/18", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124", "text": "", "text_after": "", "title": "Limit of compensatory award etc."}
{"coordinate": "uk/ukpga/1996/18/s124/1", "crossheading": null, "number_label": "1", "order": 3999, "parent": "uk/ukpga/1996/18/s124", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/1", "text": "The amount of—", "text_after": "shall not exceed the amount specified in subsection (1ZA).", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/1/a", "crossheading": null, "number_label": "a", "order": 4000, "parent": "uk/ukpga/1996/18/s124/1", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/1/a", "text": "any compensation awarded to a person under section 117(1) and (2), or", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/1/b", "crossheading": null, "number_label": "b", "order": 4001, "parent": "uk/ukpga/1996/18/s124/1", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/1/b", "text": "a compensatory award to a person calculated in accordance with section 123,", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/1ZA", "crossheading": null, "number_label": "1ZA", "order": 4002, "parent": "uk/ukpga/1996/18/s124", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/1ZA", "text": "The amount specified in this subsection is the lower of—", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/1ZA/a", "crossheading": null, "number_label": "a", "order": 4003, "parent": "uk/ukpga/1996/18/s124/1ZA", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/1ZA/a", "text": "£123,543, and", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/1ZA/b", "crossheading": null, "number_label": "b", "order": 4004, "parent": "uk/ukpga/1996/18/s124/1ZA", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/1ZA/b", "text": "52 multiplied by a week’s pay of the person concerned.", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/1A", "crossheading": null, "number_label": "1A", "order": 4005, "parent": "uk/ukpga/1996/18/s124", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/1A", "text": "Subsection (1) shall not apply to compensation awarded, or a compensatory award made, to a person in a case where he is regarded as unfairly dismissed by virtue of section 100, 103A, 105(3) or 105(6A).", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/2", "crossheading": null, "number_label": "2", "order": 4006, "parent": "uk/ukpga/1996/18/s124", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/2", "text": ". . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/3", "crossheading": null, "number_label": "3", "order": 4007, "parent": "uk/ukpga/1996/18/s124", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/3", "text": "In the case of compensation awarded to a person under section 117(1) and (2), the limit imposed by this section may be exceeded to the extent necessary to enable the award fully to reflect the amount specified as payable under section 114(2)(a) or section 115(2)(d).", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/4", "crossheading": null, "number_label": "4", "order": 4008, "parent": "uk/ukpga/1996/18/s124", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/4", "text": "Where—", "text_after": "the limit imposed by this section on the compensatory award may be exceeded to the extent necessary to enable the aggregate of the compensatory and additional awards fully to reflect the amount specified as payable under section 114(2)(a) or section 115(2)(d).", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/4/a", "crossheading": null, "number_label": "a", "order": 4009, "parent": "uk/ukpga/1996/18/s124/4", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/4/a", "text": "a compensatory award is an award under paragraph (a) of subsection (3) of section 117, and", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/4/b", "crossheading": null, "number_label": "b", "order": 4010, "parent": "uk/ukpga/1996/18/s124/4", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/4/b", "text": "an additional award falls to be made under paragraph (b) of that subsection,", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/5", "crossheading": null, "number_label": "5", "order": 4011, "parent": "uk/ukpga/1996/18/s124", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/5", "text": "The limit imposed by this section applies to the amount which the employment tribunal would, apart from this section, award in respect of the subject matter of the complaint after taking into account—", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/5/a", "crossheading": null, "number_label": "a", "order": 4012, "parent": "uk/ukpga/1996/18/s124/5", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/5/a", "text": "any payment made by the respondent to the complainant in respect of that matter, and", "text_after": "", "title": null}
{"coordinate": "uk/ukpga/1996/18/s124/5/b", "crossheading": null, "number_label": "b", "order": 4013, "parent": "uk/ukpga/1996/18/s124/5", "record_type": "provision", "repealed": false, "source_url": "https://www.legislation.gov.uk/ukpga/1996/18/section/124/5/b", "text": "any reduction in the amount of the award required by any enactment or rule of law.", "text_after": "", "title": null}
