# Point-in-time CLML versions for the anchor batteries (official documents, never committed)
anchors_xml/

# Local LLM router key (never committed)
.router_key

# Run logs and stderr captures
results/*.log
results/*.err

# Third-party answers (anonymised) from legal-rag-audit live runs: local only, never committed
external/
