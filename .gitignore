.router_key

# Run logs and stderr captures
results/*.log
results/*.err

# Third-party answers (anonymised) from legal-rag-audit live runs: local only, never committed
external/

# Grid blind review: the sheet quotes full statute text; the key would unblind it
results/grid/review_sheet.md
results/grid/review_key.json

# stop 29 raw replay: prompt token ids encode statute text from data/ (arms.jsonl is the kept copy)
results/grid/replay/sglang.jsonl

# Stop 36 blind review: the sheet quotes full statute text; the key would unblind it (its hash is in GRID.md)
results/grid/rollback/sheet.md
results/grid/rollback/key.json

# Stop 37 grading: the key would unblind your grades (its hash is in GRID.md)
results/software/review/key.json

# Stop 41 pilot: the stored prompts quote full statute text from data/ (pilot-facts.jsonl is the kept copy)
results/normalise/gemini-3.8-flash-high/pilot_*

# Stop 42: judge prompts and score inputs quote full statute text from data/ (labels/ and scores/ are the kept copy)
results/auditor_judge/pilot/

# Stop 43 fresh test: answers and key would unblind the sheet; the sheet quotes full statute text (seal.json keeps their sha256)
results/fresh/answers.jsonl
results/fresh/key.json
results/fresh/sheet.md
